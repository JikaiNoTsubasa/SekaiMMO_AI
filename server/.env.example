# Configuration du serveur SekaiMMO
# Copiez ce fichier vers .env et remplissez les valeurs

# Base de données PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/sekai_mmo"

# Secret pour les tokens JWT (choisir une chaîne longue et aléatoire)
JWT_SECRET="changez_moi_avec_une_chaine_securisee_longue"

# Port du serveur (défaut: 4000)
PORT=4000

# URL du client (pour CORS)
CLIENT_ORIGIN="http://localhost:5173"
